doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Location Details
    link(rel="stylesheet", href="/styles.css")
    script(src="/htmx.min.js")
  body
    .pmt__store-locator(hx-trigger="load" hx-get="/locations" hx-target=".pmt__location-list")
      .pmt__sidebar
        form.search-bar(hx-get="/locations" hx-target=".pmt__location-list")
            input(class="pmt__search-input" type="text" name="search" placeholder="Search for a location")
            button(class="pmt__search-button" type="submit") Search
        ul.pmt__location-list

      .pmt__location-container
