extends layout

block content
  div.location-detail
    h2= location.name
    p.description= location.description
    
    div.location-info
      div.coordinates
        h3 Coordinates
        p Lat: #{location.coordinates.lat}, Lng: #{location.coordinates.lng}
      
      - var hours = location.hours
      include components/hours
      
      div.services
        h3 Services
        ul
          each service in location.services
            li= service
      
      div.goods
        h3 Goods
        ul
          each good in location.goods
            li= good
